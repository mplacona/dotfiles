#!/bin/bash
# Attach to a tmux session on another machine over ssh, reconnecting whenever
# the connection drops (lid closed, network change). ssh rather than mosh
# because mosh strips OSC 8 hyperlinks, so links would not be clickable.
#
# usage: remote-tmux <user@host> <session>

if [ "$#" -ne 2 ]; then
  echo "usage: remote-tmux <user@host> <session>" >&2
  exit 2
fi
host="$1" session="$2"

while true; do
  # The Mac mini has no terminfo for Ghostty; its tmux enables hyperlinks for xterm-256color.
  TERM=xterm-256color ssh -t -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -o ConnectTimeout=5 \
    "$host" tmux new -As "$session"
  status=$?
  [ "$status" -eq 255 ] || exit "$status"   # 255 = connection dropped; anything else = detached or quit
  echo "Connection lost, reconnecting…"
  sleep 2
done
