# Aliases
alias prettyjson='python -m json.tool'
alias adb-list='adb shell pm list packages -3'
# Only strip pyenv shims from brew's PATH on machines that have pyenv
if command -v pyenv >/dev/null 2>&1; then
  alias brew="env PATH=${PATH//$(pyenv root)\/shims:/} brew"
fi
alias brewup='brew update; brew upgrade; brew cleanup; brew doctor'
alias speedtest='curl -o /dev/null http://speedtest.wdc01.softlayer.com/downloads/test10.zip'
alias reload='source ~/.zshrc'
alias placonaup='docker-compose up nginx-proxy placona jekyll'
alias cat="bat"
alias ls="ls -lSrhat"
alias ip="echo Your ip is; dig +short myip.opendns.com @resolver1.opendns.com;"
alias du="du -sh * | sort -h"
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# Directory shortcuts
alias p='cd ~/Projects/'
alias d='cd ~/Downloads/'
alias dev='cd ~/Projects/DevRelWork'
alias o='cd "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Vault"'
alias pi='~/.pi/agent/sync-local-models.py >/dev/null; /opt/homebrew/bin/pi'

# Swap which large oMLX model is resident (only one fits at a time)
[[ -x ~/models/omlx-use.sh ]] && alias omlx-use='~/models/omlx-use.sh'

# DevRel tmux session
function devrel() {
  cd "$HOME/Projects/DevRelWork"
  printf '\e]0;🔵 DevRel\a'
  tmux attach -t devrel 2>/dev/null || \
  tmux new-session -d -s devrel \; \
    set-option -t devrel status-style bg=blue,fg=black \; \
    rename-window "🔵 DevRel"
  tmux attach -t devrel
}

# True when the given IP is bound to one of this machine's interfaces.
# Checks both macOS (ifconfig) and Linux (iproute2) so the same file works everywhere.
function _is_this_host() {
  # `command ip`: the ip alias above would otherwise run a public-IP lookup here.
  { ifconfig 2>/dev/null; command ip -4 -o addr show 2>/dev/null; } | grep -qE "inet $1( |/)"
}

# Open one of the agent sessions.  From another machine we ssh into the host
# (bin/remote-tmux reconnects automatically if the connection drops);
# on the host itself we run the real binary in a local tmux session — these
# functions share a name with the executables in ~/.local/bin and would
# otherwise shadow them.
# usage: _agent_session <host-ip> <session> <title> <command> [args...]
function _agent_session() {
  local ip="$1" session="$2" title="$3"
  shift 3
  printf '\e]0;%s\a' "$title"

  if ! _is_this_host "$ip"; then
    ~/dotfiles/bin/remote-tmux "mplacona@$ip" "$session"
    return
  fi

  # Args, or already sitting in the session: just run the agent right here.
  if [ "$#" -gt 1 ] || [ "$(tmux display-message -p '#S' 2>/dev/null)" = "$session" ]; then
    command "$@"
    return
  fi

  # Start it detached.  A clean quit closes the session; a crash drops to a
  # shell instead, so the error stays on screen to read.
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" "command $* || exec ${SHELL:-/bin/zsh}"
  fi

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

# VPS tmux session + SSH
function vps() {
  printf '\e]0;🔴 VPS\a'
  tmux attach -t vps 2>/dev/null || \
  tmux new-session -d -s vps \; \
    set-option -t vps status-style bg=red,fg=white \; \
    rename-window "🔴 VPS"
  tmux attach -t vps
  ssh mplacona@100.102.111.19
}

# Hermes agent sessions — live on the Mac mini, reachable from anywhere
function clientwork() {
  _agent_session 100.68.121.13 clientwork '🟢 ClientWork' clientwork "$@"
}

function hermes() {
  _agent_session 100.68.121.13 hermes '⚫ Hermes' hermes "$@"
}


# CD into Obsidian file's directory from clipboard path
obslink() {
  cd "$(dirname "$(pbpaste)")"
}
