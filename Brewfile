# Command-line tools for every Mac, laptops and the Mac mini alike.
# install.sh runs `brew bundle --no-upgrade`, so this only adds what is missing;
# it never upgrades or removes anything. Desktop apps are in Brewfile.apps.

# Shell and terminal
brew "tmux"
brew "mosh"
brew "bat"            # `cat` is aliased to bat
brew "ripgrep"
brew "fd"
brew "fzf"
brew "tree"
brew "wget"
brew "coreutils"
brew "jq"
brew "yq"

# Git
brew "git"
brew "git-lfs"
brew "git-delta"
brew "gh"

# Languages and package managers
brew "pipx"
brew "uv"
brew "pnpm"

# Dev tools
brew "shellcheck"
brew "actionlint"
brew "httpie"
brew "pandoc"
brew "ffmpeg"
brew "age"
brew "mkcert"
brew "direnv"
brew "supabase/tap/supabase", trusted: true
brew "infisical/get-cli/infisical", trusted: true

# Apple platforms
brew "asc"
brew "xcodegen"
brew "swiftformat"
brew "xcbeautify"
brew "xcode-build-server"

# Sync
brew "syncthing"
